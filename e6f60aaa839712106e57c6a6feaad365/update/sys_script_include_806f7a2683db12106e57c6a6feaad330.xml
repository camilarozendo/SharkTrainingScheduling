        <script><![CDATA[var STSUtils = Class.create();
STSUtils.prototype = {
    initialize: function() {
    },
    
    getUsersByGroup: function(groupSysId) {
        var usersInGroup = [];
        var grGroupMember = new GlideRecord('sys_user_grmember');
        grGroupMember.addQuery('group', groupSysId); 
        grGroupMember.query();
        
        while(grGroupMember.next()) {
            usersInGroup.push(grGroupMember.user.sys_id.toString());
        }

        return "sys_idIN" + usersInGroup.join(',');
    },

    type: 'STSUtils'
};]]></script>
