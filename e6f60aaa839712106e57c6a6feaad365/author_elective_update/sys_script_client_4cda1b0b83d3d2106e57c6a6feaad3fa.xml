        <messages/>
        <name>Prevent Duplicate Training on Submit</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var courseId = g_form.getValue('course');
    var trainingDate = g_form.getValue('schedule_date');
    
    if (!courseId || !trainingDate) {
        return true; 
    }

    var ga = new GlideAjax('TrainingValidationUtils');
    ga.addParam('sysparm_name', 'validateTrainingDate');
    ga.addParam('sysparm_course_id', courseId);
    ga.addParam('sysparm_training_date', trainingDate);

    ga.getAnswer(function(response) {
        if (response === 'true') {
            g_form.showFieldMsg('schedule_date', 'Já existe um treinamento para este curso nesta data!', 'error');
            return false; 
        } else {
            return true; 
        }
    });

    return false; 
}
]]></script>
