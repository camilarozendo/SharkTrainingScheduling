        <description/>
        <mobile_callable>false</mobile_callable>
        <name>RegistrationFilterUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var RegistrationFilterUtils = Class.create();
RegistrationFilterUtils.prototype = {
    initialize: function () {},

    getFilteredRegistrations: function () {
        var loggedInInstructorId = gs.getUserID();
        var courseIds = [];
        var registrationIds = [];

        // Obter os cursos associados às agendas do instrutor logado
        var scheduleGr = new GlideRecordSecure('x_1567520_shark_0_training_schedule');
        scheduleGr.addQuery('instructor', loggedInInstructorId);
        scheduleGr.query();

        while (scheduleGr.next()) {
            courseIds.push(scheduleGr.course.toString());
        }

        if (courseIds.length > 0) {
            // Obter as matrículas relacionadas aos cursos identificados
            var registrationGr = new GlideRecordSecure('x_1567520_shark_0_registration');
            registrationGr.addQuery('course', 'IN', courseIds);
            registrationGr.query();

            while (registrationGr.next()) {
                registrationIds.push(registrationGr.sys_id.toString());
            }
        }

        return JSON.stringify(registrationIds); // Retorna uma lista de sys_ids de matrículas
    },

    type: 'RegistrationFilterUtils',
};
]]></script>
