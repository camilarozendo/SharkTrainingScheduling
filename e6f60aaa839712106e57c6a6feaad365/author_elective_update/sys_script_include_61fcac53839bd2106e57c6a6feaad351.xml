    <sys_script_include action="DELETE">
        <access>public</access>
        <active>false</active>
        <api_name>x_1567520_shark_0.TrainingRegistrationUtils</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description>Validate that a user is not already enrolled in the same training session.</description>
        <mobile_callable>false</mobile_callable>
        <name>TrainingRegistrationUtils</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingUtils = Class.create();
TrainingUtils.prototype = {
    initialize: function() {
    },

    refQualAvailableCourses: function() {
        var userId = gs.getUserID();  
        var enrolledCourses = []; 

        var grRegistration = new GlideRecord('x_1567520_shark_0_training_registration');
        grRegistration.addQuery('opened_by', userId);
        grRegistration.addQuery('registration_status', 3); 
        grRegistration.query();

        while (grRegistration.next()) {
            enrolledCourses.push(grRegistration.course.sys_id.toString());
        }

        var availableCourses = [];

        var grCourse = new GlideRecord('x_1567520_shark_0_training_course');
        grCourse.query();

        while (grCourse.next()) {
            if (enrolledCourses.indexOf(grCourse.sys_id.toString()) === -1) {  
                availableCourses.push(grCourse.sys_id.toString());  
            }
        }

        return "sys_idIN" + availableCourses.join(",");
    },

    type: 'TrainingUtils'
};
]]></script>
