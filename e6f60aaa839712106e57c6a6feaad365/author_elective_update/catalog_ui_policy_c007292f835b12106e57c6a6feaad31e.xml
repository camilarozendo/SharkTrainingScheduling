        <script_true><![CDATA[function onCondition() {
    var trainingDate = g_form.getValue('schedule_date'); 
    
    if (!trainingDate) {
        return;
    }

    var trainingUtils = new x_1567520_shark_0.TrainingUtils(); 
    var courses = trainingUtils.getCoursesByScheduleDate(trainingDate);
    
    var coursesToExclude = trainingUtils.refQualCourses(trainingDate);
    var completedCourses = trainingUtils.refQualCompletedCourses();
    var instructorCourses = trainingUtils.refQualInstructorCourses();
    var coursesWithNoVacancies = trainingUtils.refQualCoursesWithNoVacancies();
    var coursesWithValidDate = trainingUtils.refQualCoursesWithValidDate();

    var validCourses = courses.filter(function(course) {
        return coursesToExclude.indexOf(course) === -1 &&
               completedCourses.indexOf(course) === -1 &&
               instructorCourses.indexOf(course) === -1 &&
               coursesWithNoVacancies.indexOf(course) === -1 &&
               coursesWithValidDate.indexOf(course) !== -1;
    });

    if (validCourses.length === 0) {
        g_form.setDisplay('schedule_date', false);
    } else {
        g_form.setDisplay('schedule_date', true); 
    }
}]]></script_true>
