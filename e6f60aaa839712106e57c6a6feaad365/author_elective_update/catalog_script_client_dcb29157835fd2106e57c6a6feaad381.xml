        <name>Check Duplicate Training Registration</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }

    var userID = g_user.id;  
    var scheduleDate = g_form.getValue('schedule_date');  

    var availableCourses = getAvailableCourses(userID, scheduleDate);

    g_form.clearOptions('course_field');

    for (var i = 0; i < availableCourses.length; i++) {
        g_form.addOption('course_field', availableCourses[i].sys_id, availableCourses[i].name);
    }
}

function getAvailableCourses(userID, scheduleDate) {
    var courses = [];
    var registrationGR = new GlideRecord('x_1567520_shark_0_training_registration');
    registrationGR.addQuery('opened_by', userID);
    registrationGR.addQuery('schedule_date', scheduleDate);  
    registrationGR.addQuery('registration_status', '3'); 
    registrationGR.query();

    var enrolledCourses = [];
    while (registrationGR.next()) {
        enrolledCourses.push(registrationGR.course.sys_id);  
    }

    var courseGR = new GlideRecord('x_1567520_shark_0_training_course');
    courseGR.query();

    while (courseGR.next()) {
        if (enrolledCourses.indexOf(courseGR.sys_id) == -1) { 
            courses.push({
                sys_id: courseGR.sys_id,
                name: courseGR.name
            });
        }
    }

    return courses;
}
]]></script>
