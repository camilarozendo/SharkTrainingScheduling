        <messages/>
        <name>Registration Filter</name>
        <order/>
        <script><![CDATA[function onLoad() {
    var ga = new GlideAjax('RegistrationFilterUtils');
    ga.addParam('sysparm_name', 'getFilteredRegistrations');
    ga.getXMLAnswer(function(response) {
        var registrationIds = JSON.parse(response); // Converte a resposta para um array

        if (registrationIds.length > 0) {
            // Aplica o filtro para exibir apenas as matrículas retornadas
            g_list.filter('sys_idIN' + registrationIds.join(','));
        } else {
            // Caso não haja matrículas, mostra uma mensagem ou limpa os registros
            g_list.filter('sys_idISEMPTY');
        }
    });
}

]]></script>
